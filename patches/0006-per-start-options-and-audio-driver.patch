 namespace AudioCore {
 
+namespace {
+/// Creates the cubeb context. AZAHAR_CUBEB_BACKEND (the MH4U port's Android audio driver
+/// setting: "aaudio" or "opensl") picks the backend; unset or unavailable: cubeb's own choice.
+int InitCubeb(cubeb** ctx, const char* name) {
+    const char* wanted = std::getenv("AZAHAR_CUBEB_BACKEND");
+    if (wanted && wanted[0]) {
+        if (cubeb_init(ctx, name, wanted) == CUBEB_OK) {
+            LOG_INFO(Audio_Sink, "Audio driver: {} (requested)", cubeb_get_backend_id(*ctx));
+            return CUBEB_OK;
+        }
+        LOG_WARNING(Audio_Sink, "Audio driver {} is not available, using the default", wanted);
+    }
+    const int result = cubeb_init(ctx, name, nullptr);
+    if (result == CUBEB_OK) {
+        LOG_INFO(Audio_Sink, "Audio driver: {} (default)", cubeb_get_backend_id(*ctx));
+    }
+    return result;
+}
+} // namespace
+
 struct CubebSink::Impl {
     cubeb* ctx = nullptr;
     cubeb_stream* stream = nullptr;
