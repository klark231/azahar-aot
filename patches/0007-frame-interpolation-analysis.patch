+// Copyright 2026 Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <chrono>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+
+#include "common/common_types.h"
+#include "video_core/frame_interp/frame_interp.h"
+
+namespace Pica {
+class PicaCore;
+struct RegsInternal;
+} // namespace Pica
+
+namespace FrameInterp {
+
+/// Whether frame interpolation analysis is on (environment variable AZAHAR_FRAME_INTERP=1, set
+/// from the app's settings). Off by default.
+bool Enabled();
+
+/// The output registers that place a vertex (its position, and the normal and the view the
+/// lighting takes) and those that carry its textures' coordinates, one bit each, as the
+/// vertex shader output map and mask describe them.
+void PlacingOutputs(const Pica::RegsInternal& regs, u16& placing, u16& coordinates);
+
+/// Stage A of frame interpolation: reads each accelerated draw's state off the PICA registers,
+/// matches it with the frame before's draws, and logs how well that goes every few seconds. It
+/// draws nothing and changes nothing the game or the renderer sees.
+class Driver {
+public:
+    explicit Driver(std::chrono::milliseconds report_every = std::chrono::seconds(5))
+        : report_every{report_every} {}
+
+    /// A draw is about to be rendered. `accelerate` says the vertex shader runs on the GPU, so
+    /// its matrices are in the float uniforms; a draw shaded on the CPU is only counted.
+    void OnDraw(Pica::PicaCore& pica, bool accelerate);
+
+    /// A frame was presented. The game's frame is over if it drew anything since the last one,
+    /// which at 30 fps is every other time.
+    void OnFrameBoundary();
+
+private:
+    void Report(std::chrono::steady_clock::time_point now);
+
+    std::chrono::milliseconds report_every;
+    std::mutex mutex;
+    FrameInterpolator interpolator;
+    std::unordered_map<u64, std::shared_ptr<const Program>> programs;
+    Uniforms uniforms{};
+
+    // counted since the last report
+    u64 frames = 0, draws = 0, matched = 0, moved = 0, jumped = 0, jumping = 0;
+    u64 smooth_frames = 0, software_draws = 0, geometry_draws = 0;
+    std::chrono::nanoseconds cost{0};
+    u64 timed_draws = 0;
+    std::chrono::steady_clock::time_point last_report{std::chrono::steady_clock::now()};
+};
+
+} // namespace FrameInterp
