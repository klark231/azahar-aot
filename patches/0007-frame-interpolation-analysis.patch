+// Copyright 2026 Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+//
+// Frame interpolation, stage A: matching the draws of a frame with those of the frame before
+// and working out how they move. The algorithm and its constants come from Zakuro's
+// zakuro-gpu/src/interpolation.rs and shader analysis (zakuro-gpu/src/shader/mod.rs), ported to
+// C++. This file has no Azahar dependency, so it can be built and tested on its own
+// (tools/frame-interp-test).
+//
+// What it decides: for each draw, are the vertex shader's float uniforms that place the
+// vertices (the matrices) moving smoothly since the matching draw of the last frame, and what
+// would they be halfway in between. Nothing is rendered from this yet: stage B (twin buffers,
+// replaying the draws halfway) is not written.
+
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace FrameInterp {
+
+constexpr int FLOAT_UNIFORMS = 96;
+using Vec4 = std::array<float, 4>;
+using Uniforms = std::array<Vec4, FLOAT_UNIFORMS>;
+
+/// One bit for each of the 96 float uniforms.
+struct Mask96 {
+    uint64_t lo = 0; // uniforms 0..63
+    uint64_t hi = 0; // uniforms 64..95, in the low 32 bits
+
+    static Mask96 Bit(int i) {
+        Mask96 m;
+        (i < 64 ? m.lo : m.hi) |= uint64_t{1} << (i & 63);
+        return m;
+    }
+    /// Uniforms i and every one above it.
+    static Mask96 From(int i) {
+        Mask96 m;
+        for (int u = i; u < FLOAT_UNIFORMS; ++u) {
+            m |= Bit(u);
+        }
+        return m;
+    }
+    static Mask96 All() {
+        return From(0);
+    }
+    bool Test(int i) const {
+        return ((i < 64 ? lo : hi) >> (i & 63)) & 1;
+    }
+    bool Any() const {
+        return (lo | hi) != 0;
+    }
+    Mask96& operator|=(const Mask96& o) {
+        lo |= o.lo;
+        hi |= o.hi;
+        return *this;
+    }
+    friend Mask96 operator|(Mask96 a, const Mask96& b) {
+        return a |= b;
+    }
+    friend Mask96 operator&(const Mask96& a, const Mask96& b) {
+        return {a.lo & b.lo, a.hi & b.hi};
+    }
+    friend Mask96 operator~(const Mask96& a) {
+        return {~a.lo, ~a.hi & 0xFFFFFFFFull};
+    }
+    friend bool operator==(const Mask96& a, const Mask96& b) {
+        return a.lo == b.lo && a.hi == b.hi;
+    }
+    friend bool operator!=(const Mask96& a, const Mask96& b) {
+        return !(a == b);
+    }
+};
+
+// ---------------------------------------------------------------------------------------------
+// Shader analysis: which float uniforms feed which output registers.
+// ---------------------------------------------------------------------------------------------
+
+enum class Opcode : uint8_t {
+    Add, Dp3, Dp4, Dph, Dst, Ex2, Lg2, LitP, Mul, Sge, Slt, Flr, Max, Min, Rcp, Rsq, Mova, Mov,
+    DphI, DstI, SgeI, SltI, Break, Nop, End, BreakC, Call, CallC, CallU, IfU, IfC, Loop, Emit,
+    SetEmit, JmpC, JmpU, Cmp, MadI, Mad, Unknown,
+};
+
+struct Operand {
+    uint32_t reg = 0;   // 0x00-0x0F inputs, 0x10-0x1F temporaries, 0x20-0x7F float uniforms
+    uint32_t index = 0; // the address register offsetting it, 0 for none
+};
+
+struct Op {
+    uint32_t word = 0;
+    Opcode opcode = Opcode::Unknown;
+    uint32_t destination = 0;
+    Operand src[3];
+};
+
+/// A vertex shader program, decoded once from its instruction words.
+class Program {
+public:
+    static std::shared_ptr<const Program> Decode(const uint32_t* words, size_t count);
+
+    /// The float uniforms that what lands in `outputs` (one bit per output register 0..15)
+    /// can come from, among what the program can run from `entry`: first those read as they
+    /// are, then those read through an address register, which can be any from the one named
+    /// on. Address registers and conditions are left out: they pick what runs, they do not
+    /// feed what it works out.
+    std::pair<Mask96, Mask96> UniformsFeeding(uint32_t entry, uint16_t outputs) const;
+
+    /// The uniforms that place the vertices, and those the texture coordinates may read
+    /// through an address register too, which are moved but for steps between round values
+    /// (a sprite's offset into its sheet). `outputs` places the vertices, `coordinates` are the
+    /// outputs carrying texture coordinates.
+    std::pair<Mask96, Mask96> PlacingUniforms(uint32_t entry, uint16_t outputs,
+                                              uint16_t coordinates) const;
+
+    size_t Size() const {
+        return ops_.size();
+    }
+
+private:
+    std::vector<bool> Reached(uint32_t entry) const;
+    std::vector<Op> ops_;
+};
+
+// ---------------------------------------------------------------------------------------------
+// Matching the draws of a frame with the frame before's.
+// ---------------------------------------------------------------------------------------------
+
+/// How the draws of a frame went. Of those the frame before had too: those that moved, those
+/// that jumped, and those that jumped a few frames before too (a batch of sprites sorted anew
+/// each frame, or a flag that flips).
+struct Matches {
+    uint32_t draws = 0;
+    uint32_t matched = 0;
+    uint32_t moved = 0;
+    uint32_t jumped = 0;
+    uint32_t jumping = 0;
+
+    /// Whether a picture in between would look right: most draws were there the frame before,
+    /// and few of those that had not jumped lately jumped now, as everything does when the
+    /// camera cuts.
+    bool Smooth() const {
+        return moved > 0 && matched * 2 >= draws && jumped * 4 <= matched;
+    }
+    friend bool operator==(const Matches& a, const Matches& b) {
+        return a.draws == b.draws && a.matched == b.matched && a.moved == b.moved &&
+               a.jumped == b.jumped && a.jumping == b.jumping;
+    }
+};
+
+/// What the interpolator needs to know of a draw.
+struct DrawDesc {
+    /// What the draw draws, the same from frame to frame for a model drawn the same way: its
+    /// programs, vertex arrays, the buffers it draws into and its first texture.
+    uint64_t key = 0;
+    /// The vertex shader's float uniforms at the draw.
+    const Uniforms* uniforms = nullptr;
+    /// A draw through a geometry shader is counted, never moved.
+    bool geometry = false;
+    /// For working out which uniforms place the vertices. Without a program every uniform
+    /// counts as placing.
+    const Program* program = nullptr;
+    uint64_t program_id = 0;
+    uint32_t entry = 0;
+    uint16_t outputs = 0;
+    uint16_t coordinates = 0;
+};
+
+class FrameInterpolator {
+public:
+    /// Records the draw for the next frame to match, and gives the uniforms halfway between
+    /// its own and its match's from the frame before: null when they are the same, when it has
+    /// no match, when it jumped, or when `between` is false. The pointer stays valid until the
+    /// next call.
+    const Uniforms* Draw(const DrawDesc& desc, bool between = true);
+
+    /// The frame is done: its draws are the ones the next frame's match. Returns how this
+    /// frame's draws matched the one before's.
+    Matches FrameDone();
+
+    /// Draws recorded since the last FrameDone.
+    uint32_t DrawsThisFrame() const {
+        return draws_;
+    }
+
+private:
+    struct Drawn {
+        std::vector<Uniforms> uniforms;
+        std::vector<Uniforms> moves; // how far each one's uniforms moved since the frame before
+        std::vector<uint8_t> restless;
+        std::vector<bool> taken; // which a draw of the next frame took for its own
+    };
+    struct PlacingKey {
+        uint64_t program_id;
+        uint32_t entry;
+        uint16_t outputs;
+        uint16_t coordinates;
+        bool operator==(const PlacingKey& o) const {
+            return program_id == o.program_id && entry == o.entry && outputs == o.outputs &&
+                   coordinates == o.coordinates;
+        }
+    };
+    struct PlacingKeyHash {
+        size_t operator()(const PlacingKey& k) const {
+            uint64_t h = k.program_id * 0x9E3779B97F4A7C15ull;
+            h ^= (uint64_t{k.entry} << 32 | uint64_t{k.outputs} << 16 | k.coordinates) +
+                 0x7F4A7C15ull + (h << 6) + (h >> 2);
+            return static_cast<size_t>(h);
+        }
+    };
+
+    std::unordered_map<uint64_t, Drawn> before_;
+    std::unordered_map<uint64_t, Drawn> now_;
+    std::unordered_map<PlacingKey, std::pair<Mask96, Mask96>, PlacingKeyHash> placing_;
+    Uniforms between_{};
+    uint32_t draws_ = 0, matched_ = 0, moved_ = 0, jumped_ = 0, jumping_ = 0;
+};
+
+} // namespace FrameInterp
