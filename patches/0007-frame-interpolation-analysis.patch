--- a/src/video_core/frame_interp/frame_interp_driver.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/src/video_core/frame_interp/frame_interp_driver.cpp	2026-10-27 23:48:29.146581888 +0000
@@ -0,0 +1,244 @@
+// Copyright 2026 Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include "video_core/frame_interp/frame_interp_driver.h"
+
+#include <algorithm>
+#include <bit>
+#include <cstdlib>
+
+#include "common/logging/log.h"
+#include "video_core/pica/pica_core.h"
+
+namespace FrameInterp {
+
+bool Enabled() {
+    static const bool enabled = [] {
+        const char* v = std::getenv("AZAHAR_FRAME_INTERP");
+        return v && v[0] == '1';
+    }();
+    return enabled;
+}
+
+namespace {
+
+u64 Mix(u64 hash, u64 word) {
+    return (std::rotl(hash, 5) ^ word) * 0x517CC1B722220A95ull;
+}
+
+/// What a draw draws, the same from frame to frame for a model drawn the same way: its
+/// programs, its vertex arrays, and the buffers it draws into and its first texture. The
+/// register numbers are the PICA's own (the same as the index into the register file).
+u64 DrawKey(const Pica::RegsInternal& regs, u64 vs_hash, u32 vs_entry, bool geometry, u64 gs_hash,
+            u32 gs_entry) {
+    constexpr u32 REG_TEXTURE0_ADDRESS = 0x0085;
+    constexpr u32 REG_DEPTH_BUFFER_ADDRESS = 0x011C;
+    constexpr u32 REG_COLOR_BUFFER_ADDRESS = 0x011D;
+    constexpr u32 REG_ATTRIBUTE_BASE = 0x0200;
+    constexpr u32 REG_INDEX_ARRAY = 0x0227;
+    constexpr u32 REG_VERTEX_COUNT = 0x0228;
+    constexpr u32 REG_GEOSTAGE_CONFIG = 0x0229;
+    constexpr u32 REG_VERTEX_OFFSET = 0x022A;
+    constexpr u32 REG_PRIMITIVE_CONFIG = 0x025E;
+
+    // from an odd start, so that words of zero still count
+    u64 hash = Mix(Mix(0x9E3779B97F4A7C15ull, vs_hash), vs_entry);
+    if (geometry) {
+        hash = Mix(Mix(Mix(hash, 1), gs_hash), gs_entry);
+    }
+    const auto& r = regs.reg_array;
+    for (u32 reg = REG_ATTRIBUTE_BASE; reg <= REG_INDEX_ARRAY; ++reg) {
+        hash = Mix(hash, r[reg]);
+    }
+    for (const u32 reg : {REG_VERTEX_COUNT, REG_VERTEX_OFFSET, REG_PRIMITIVE_CONFIG,
+                          REG_GEOSTAGE_CONFIG, REG_COLOR_BUFFER_ADDRESS, REG_DEPTH_BUFFER_ADDRESS,
+                          REG_TEXTURE0_ADDRESS}) {
+        hash = Mix(hash, r[reg]);
+    }
+    return hash;
+}
+
+} // namespace
+
+/// The vertex shader's outputs are the registers the output mask enables, in order: attribute 2
+/// is the third enabled register, which is not necessarily o2.
+void PlacingOutputs(const Pica::RegsInternal& regs, u16& placing, u16& coordinates) {
+    const u32 total = std::min<u32>(static_cast<u32>(regs.rasterizer.vs_output_total), 7);
+    constexpr int NONE = -1;
+    // attribute slot of each semantic
+    int position[4] = {0, 0, 0, 0};
+    int quaternion[4] = {NONE, NONE, NONE, NONE};
+    int view[3] = {NONE, NONE, NONE};
+    int texcoord[3][2] = {{3, 3}, {NONE, NONE}, {NONE, NONE}}; // the default, see below
+    bool saw_position = false;
+    if (total != 0) {
+        int tex[3][2] = {{NONE, NONE}, {NONE, NONE}, {NONE, NONE}};
+        for (u32 attribute = 0; attribute < total; ++attribute) {
+            const u32 word = regs.rasterizer.vs_output_attributes[attribute].raw;
+            for (u32 component = 0; component < 4; ++component) {
+                const u32 semantic = (word >> (component * 8)) & 0x1F;
+                const int slot = static_cast<int>(attribute);
+                if (semantic <= 3) {
+                    position[semantic] = slot;
+                    saw_position = true;
+                } else if (semantic <= 7) {
+                    quaternion[semantic - 4] = slot;
+                } else if (semantic >= 12 && semantic <= 13) {
+                    tex[0][semantic - 12] = slot;
+                } else if (semantic >= 14 && semantic <= 15) {
+                    tex[1][semantic - 14] = slot;
+                } else if (semantic >= 18 && semantic <= 20) {
+                    view[semantic - 18] = slot;
+                } else if (semantic >= 22 && semantic <= 23) {
+                    tex[2][semantic - 22] = slot;
+                }
+            }
+        }
+        if (saw_position) {
+            for (int s = 0; s < 3; ++s) {
+                texcoord[s][0] = tex[s][0];
+                texcoord[s][1] = tex[s][1];
+            }
+        }
+    }
+    if (!saw_position) {
+        // the layout picasso/nihstro assign when the registers describe nothing at all
+        for (int& p : position) {
+            p = 0;
+        }
+        for (int& q : quaternion) {
+            q = NONE;
+        }
+        for (int& v : view) {
+            v = NONE;
+        }
+    }
+
+    // the output register behind an attribute: the nth one the mask enables
+    const u32 mask = static_cast<u32>(regs.vs.output_mask) & 0xFFFF;
+    const auto register_of = [mask](int attribute) -> int {
+        int seen = 0;
+        for (int reg = 0; reg < 16; ++reg) {
+            if (mask != 0 && !(mask & (1u << reg))) {
+                continue;
+            }
+            if (seen++ == attribute) {
+                return reg;
+            }
+        }
+        return NONE;
+    };
+    placing = 0;
+    coordinates = 0;
+    const auto add = [&](u16& out, int attribute) {
+        if (attribute == NONE) {
+            return;
+        }
+        const int reg = register_of(attribute);
+        if (reg != NONE) {
+            out |= static_cast<u16>(1u << reg);
+        }
+    };
+    for (const int a : position) add(placing, a);
+    for (const int a : quaternion) add(placing, a);
+    for (const int a : view) add(placing, a);
+    for (const auto& set : texcoord) {
+        for (const int a : set) add(coordinates, a);
+    }
+}
+
+void Driver::OnDraw(Pica::PicaCore& pica, bool accelerate) {
+    const auto start = std::chrono::steady_clock::now();
+    std::lock_guard lock{mutex};
+    ++draws;
+    if (!accelerate) {
+        // shaded on the CPU: what moves is in the vertices, not in the uniforms
+        ++software_draws;
+        return;
+    }
+    const auto& regs = pica.regs.internal;
+    const bool geometry = regs.pipeline.use_gs == Pica::PipelineRegs::UseGS::Yes;
+    geometry_draws += geometry;
+
+    auto& setup = pica.vs_setup;
+    const u64 vs_hash = setup.GetProgramCodeHash() ^ (setup.GetSwizzleDataHash() * 31);
+    auto it = programs.find(vs_hash);
+    if (it == programs.end()) {
+        if (programs.size() > 256) {
+            programs.clear();
+        }
+        const u32 size = std::min<u32>(setup.GetBiggestProgramSize(), Pica::MAX_PROGRAM_CODE_LENGTH);
+        it = programs
+                 .emplace(vs_hash, size ? Program::Decode(setup.GetProgramCode().data(), size)
+                                        : std::shared_ptr<const Program>{})
+                 .first;
+    }
+
+    for (int i = 0; i < FLOAT_UNIFORMS; ++i) {
+        const auto& v = setup.uniforms.f[i];
+        uniforms[i] = {v.x.ToFloat32(), v.y.ToFloat32(), v.z.ToFloat32(), v.w.ToFloat32()};
+    }
+
+    DrawDesc desc;
+    u64 gs_hash = 0;
+    u32 gs_entry = 0;
+    if (geometry) {
+        gs_hash = pica.gs_setup.GetProgramCodeHash();
+        gs_entry = pica.gs_setup.entry_point;
+    }
+    desc.key = DrawKey(regs, vs_hash, setup.entry_point, geometry, gs_hash, gs_entry);
+    desc.uniforms = &uniforms;
+    desc.geometry = geometry;
+    desc.program = it->second.get();
+    desc.program_id = vs_hash;
+    desc.entry = setup.entry_point;
+    PlacingOutputs(regs, desc.outputs, desc.coordinates);
+    interpolator.Draw(desc); // analysis only: what comes back is not drawn
+
+    cost += std::chrono::steady_clock::now() - start;
+    ++timed_draws;
+}
+
+void Driver::OnFrameBoundary() {
+    std::lock_guard lock{mutex};
+    const auto now = std::chrono::steady_clock::now();
+    // a refresh the game drew nothing in is not a frame of its own
+    if (interpolator.DrawsThisFrame() > 0) {
+        const Matches m = interpolator.FrameDone();
+        ++frames;
+        matched += m.matched;
+        moved += m.moved;
+        jumped += m.jumped;
+        jumping += m.jumping;
+        smooth_frames += m.Smooth();
+    }
+    if (now - last_report >= report_every) {
+        Report(now);
+    }
+}
+
+void Driver::Report(std::chrono::steady_clock::time_point now) {
+    const double secs = std::chrono::duration<double>(now - last_report).count();
+    if (frames > 0 && draws > 0) {
+        const auto pct = [&](u64 n) { return 100.0 * static_cast<double>(n) / draws; };
+        LOG_INFO(Render,
+                 "frame interpolation analysis (nothing is drawn from it): {:.1f} game frames/s, "
+                 "{:.0f} draws/frame ({:.1f} on the CPU, {:.1f} geometry); {:.0f}% matched the frame "
+                 "before, {:.0f}% moved smoothly, {:.1f}% jumped (+{:.1f}% keep jumping); {:.0f}% "
+                 "of frames smooth; analysis cost {:.1f} us/draw",
+                 frames / secs, static_cast<double>(draws) / frames,
+                 static_cast<double>(software_draws) / frames,
+                 static_cast<double>(geometry_draws) / frames, pct(matched), pct(moved), pct(jumped), pct(jumping),
+                 100.0 * smooth_frames / frames,
+                 timed_draws ? std::chrono::duration<double, std::micro>(cost).count() / timed_draws
+                             : 0.0);
+    }
+    frames = draws = matched = moved = jumped = jumping = 0;
+    smooth_frames = software_draws = geometry_draws = 0;
+    cost = std::chrono::nanoseconds{0};
+    timed_draws = 0;
+    last_report = now;
+}
+
+} // namespace FrameInterp
