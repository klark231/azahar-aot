+// Shader analysis
+// ---------------------------------------------------------------------------------------------
+
+namespace {
+
+Opcode OpcodeFromRaw(uint32_t value) {
+    switch (value) {
+    case 0x00: return Opcode::Add;
+    case 0x01: return Opcode::Dp3;
+    case 0x02: return Opcode::Dp4;
+    case 0x03: return Opcode::Dph;
+    case 0x04: return Opcode::Dst;
+    case 0x05: return Opcode::Ex2;
+    case 0x06: return Opcode::Lg2;
+    case 0x07: return Opcode::LitP;
+    case 0x08: return Opcode::Mul;
+    case 0x09: return Opcode::Sge;
+    case 0x0A: return Opcode::Slt;
+    case 0x0B: return Opcode::Flr;
+    case 0x0C: return Opcode::Max;
+    case 0x0D: return Opcode::Min;
+    case 0x0E: return Opcode::Rcp;
+    case 0x0F: return Opcode::Rsq;
+    case 0x12: return Opcode::Mova;
+    case 0x13: return Opcode::Mov;
+    case 0x18: return Opcode::DphI;
+    case 0x19: return Opcode::DstI;
+    case 0x1A: return Opcode::SgeI;
+    case 0x1B: return Opcode::SltI;
+    case 0x20: return Opcode::Break;
+    case 0x21: return Opcode::Nop;
+    case 0x22: return Opcode::End;
+    case 0x23: return Opcode::BreakC;
+    case 0x24: return Opcode::Call;
+    case 0x25: return Opcode::CallC;
+    case 0x26: return Opcode::CallU;
+    case 0x27: return Opcode::IfU;
+    case 0x28: return Opcode::IfC;
+    case 0x29: return Opcode::Loop;
+    case 0x2A: return Opcode::Emit;
+    case 0x2B: return Opcode::SetEmit;
+    case 0x2C: return Opcode::JmpC;
+    case 0x2D: return Opcode::JmpU;
+    // the low opcode bit belongs to the first comparison mode
+    case 0x2E:
+    case 0x2F: return Opcode::Cmp;
+    default:
+        // multiply-add only uses the top three opcode bits, the rest of the field holds the
+        // destination register
+        if (value >= 0x30 && value <= 0x37) return Opcode::MadI;
+        if (value >= 0x38 && value <= 0x3F) return Opcode::Mad;
+        return Opcode::Unknown;
+    }
+}
+
+/// Whether it writes a destination register, which arithmetic does but for mova and cmp.
+bool Writes(Opcode op) {
+    switch (op) {
+    case Opcode::Add: case Opcode::Dp3: case Opcode::Dp4: case Opcode::Dph: case Opcode::Dst:
+    case Opcode::Ex2: case Opcode::Lg2: case Opcode::LitP: case Opcode::Mul: case Opcode::Sge:
+    case Opcode::Slt: case Opcode::Flr: case Opcode::Max: case Opcode::Min: case Opcode::Rcp:
+    case Opcode::Rsq: case Opcode::Mov: case Opcode::DphI: case Opcode::DstI: case Opcode::SgeI:
+    case Opcode::SltI: case Opcode::Mad: case Opcode::MadI:
+        return true;
+    default:
+        return false;
+    }
+}
+
+/// The inverted encodings have the wide operand (the one that can be a uniform) second.
+bool IsInverted(Opcode op) {
+    return op == Opcode::DphI || op == Opcode::DstI || op == Opcode::SgeI || op == Opcode::SltI;
+}
+
+Op DecodeOp(uint32_t w) {
+    Op op;
+    op.word = w;
+    op.opcode = OpcodeFromRaw(w >> 26);
+    if (op.opcode == Opcode::Mad || op.opcode == Opcode::MadI) {
+        const uint32_t src1 = (w >> 17) & 0x1F;
+        uint32_t src2, src3;
+        if (op.opcode == Opcode::MadI) {
+            src2 = (w >> 12) & 0x1F;
+            src3 = (w >> 5) & 0x7F;
+        } else {
+            src2 = (w >> 10) & 0x7F;
+            src3 = (w >> 5) & 0x1F;
+        }
+        // the address register applies to whichever source is the wide one
+        const uint32_t index = (w >> 22) & 0x3;
+        op.destination = (w >> 24) & 0x1F;
+        op.src[0] = {src1, 0};
+        op.src[1] = {src2, op.opcode == Opcode::MadI ? 0u : index};
+        op.src[2] = {src3, op.opcode == Opcode::MadI ? index : 0u};
+    } else {
+        const bool inverted = IsInverted(op.opcode);
+        const uint32_t src1 = inverted ? (w >> 14) & 0x1F : (w >> 12) & 0x7F;
+        const uint32_t src2 = inverted ? (w >> 7) & 0x7F : (w >> 7) & 0x1F;
+        // only the wide operand can be a uniform, and only a uniform read can be indexed
+        const uint32_t index = (w >> 19) & 0x3;
+        op.destination = (w >> 21) & 0x1F;
+        op.src[0] = {src1, inverted ? 0u : index};
+        op.src[1] = {src2, inverted ? index : 0u};
+    }
+    return op;
+}
+
+/// An if's body when it is taken, its else when it is not, and where both come back to.
+struct IfRanges {
+    uint32_t then_start, then_end, else_start, else_end, next;
+};
+IfRanges GetIfRanges(uint32_t pc, uint32_t destination, uint32_t count) {
+    const uint32_t then_end = (pc + 1) + (destination - std::min(pc + 1, destination));
+    return {pc + 1, then_end, destination, destination + count, destination + count};
+}
+
+} // namespace
+
+std::shared_ptr<const Program> Program::Decode(const uint32_t* words, size_t count) {
+    auto program = std::make_shared<Program>();
+    program->ops_.reserve(count);
+    for (size_t i = 0; i < count; ++i) {
+        program->ops_.push_back(DecodeOp(words[i]));
+    }
+    return program;
+}
+
+std::vector<bool> Program::Reached(uint32_t entry) const {
+    std::vector<bool> reached(ops_.size(), false);
+    std::set<std::pair<uint32_t, uint32_t>> walked;
+    std::vector<std::pair<uint32_t, uint32_t>> ranges;
+    ranges.emplace_back(entry, static_cast<uint32_t>(ops_.size()));
+    while (!ranges.empty()) {
+        const auto [start, end] = ranges.back();
+        ranges.pop_back();
+        if (!walked.insert({start, end}).second) {
+            continue;
+        }
+        uint32_t pc = start;
+        while (pc < end && pc < ops_.size()) {
+            reached[pc] = true;
+            const Op& op = ops_[pc];
+            const uint32_t destination = (op.word >> 10) & 0xFFF;
+            const uint32_t count = op.word & 0xFF;
+            bool stop = false, jumped = false;
+            switch (op.opcode) {
+            case Opcode::End:
+                stop = true;
+                break;
+            case Opcode::Call:
+            case Opcode::CallC:
+            case Opcode::CallU:
+                ranges.emplace_back(destination, destination + count);
+                break;
+            case Opcode::JmpC:
+            case Opcode::JmpU:
+                ranges.emplace_back(destination, end);
+                break;
+            case Opcode::IfC:
+            case Opcode::IfU: {
+                const IfRanges r = GetIfRanges(pc, destination, count);
+                ranges.emplace_back(r.then_start, r.then_end);
+                ranges.emplace_back(r.else_start, r.else_end);
+                if (r.next <= pc) {
+                    stop = true;
+                } else {
+                    pc = r.next;
+                    jumped = true;
+                }
+                break;
+            }
+            case Opcode::Loop:
+                ranges.emplace_back(pc + 1, destination + 1);
+                if (destination < pc) {
+                    stop = true;
+                } else {
+                    pc = destination + 1;
+                    jumped = true;
+                }
+                break;
+            default:
+                break;
+            }
+            if (stop) {
+                break;
+            }
+            if (jumped) {
+                continue;
+            }
+            ++pc;
+        }
+    }
+    return reached;
+}
+
+std::pair<Mask96, Mask96> Program::UniformsFeeding(uint32_t entry, uint16_t outputs) const {
+    const std::vector<bool> reached = Reached(entry);
+    // outputs 0x00 to 0x0F and temporaries 0x10 to 0x1F, as both destinations and sources
+    // number them
+    uint32_t wanted = outputs;
+    Mask96 uniforms, indexed;
+    for (;;) {
+        const uint32_t wanted_before = wanted;
+        const Mask96 uniforms_before = uniforms, indexed_before = indexed;
+        for (size_t i = 0; i < ops_.size(); ++i) {
+            if (!reached[i]) {
+                continue;
+            }
+            const Op& op = ops_[i];
+            int sources;
+            switch (op.opcode) {
+            case Opcode::Mad:
+            case Opcode::MadI:
+                sources = 3;
+                break;
+            case Opcode::Mov: case Opcode::Rcp: case Opcode::Rsq: case Opcode::Ex2:
+            case Opcode::Lg2: case Opcode::Flr: case Opcode::LitP:
+                sources = 1;
+                break;
+            default:
+                if (!Writes(op.opcode)) {
+                    continue;
+                }
+                sources = 2;
+            }
+            if (op.destination >= 0x20 || !(wanted & (1u << op.destination))) {
+                continue;
+            }
+            for (int s = 0; s < sources; ++s) {
+                const Operand& source = op.src[s];
+                if (source.reg >= 0x10 && source.reg <= 0x1F) {
+                    wanted |= 1u << source.reg;
+                } else if (source.reg >= 0x20 && source.reg <= 0x7F) {
+                    if (source.index != 0) {
+                        indexed |= Mask96::From(static_cast<int>(source.reg - 0x20));
+                    } else {
+                        uniforms |= Mask96::Bit(static_cast<int>(source.reg - 0x20));
+                    }
+                }
+            }
+        }
+        if (wanted == wanted_before && uniforms == uniforms_before && indexed == indexed_before) {
+            return {uniforms & Mask96::All(), indexed & Mask96::All()};
+        }
+    }
+}
+
+std::pair<Mask96, Mask96> Program::PlacingUniforms(uint32_t entry, uint16_t outputs,
+                                                   uint16_t coordinates) const {
+    const auto [direct, indexed] = UniformsFeeding(entry, outputs);
+    const auto [textured, textured_indexed] = UniformsFeeding(entry, coordinates);
+    const Mask96 own = direct | (indexed & ~(textured | textured_indexed));
+    const Mask96 shared = indexed & textured_indexed & ~textured & ~own;
+    return {own, shared};
+}
+
+// ---------------------------------------------------------------------------------------------
+// Matching draws
+// ---------------------------------------------------------------------------------------------
+
+namespace {
+
+/// How much a component's move from one frame to the next may differ from its move the frame
+/// before, before the draw counts as a different one, a jump rather than a move, which is drawn
+/// as it is. A model in the distance or the camera going on as it went moves as it did however
+/// fast, a camera cutting elsewhere, another model taken for this one or a flag kept in a float
+/// do not. A component of a rotation turning faster by less than about 30 degrees moves less
+/// than half again, a translation less than a quarter of its distance again.
+constexpr float JUMP = 0.5f;
+constexpr float JUMP_PART = 0.25f;
+
+/// How many draws of the frame before drawn the same way a draw's match is looked for among,
+/// around its own place among them.
+constexpr size_t NEAREST = 32;
+
+/// For how many frames after jumping a draw that jumps again counts as one that keeps jumping
+/// rather than as a camera cutting elsewhere. A sprite's animation that steps every other frame
+/// jumps every other frame.
+constexpr uint8_t RESTLESS = 4;
+
+/// Whether a component a texture's coordinates may read steps from one round value to another,
+/// sixty-fourths, as a sprite's offset into its sheet of them does, rather than moves, as a
+/// matrix's does.
+bool Steps(float before, float now) {
+    const auto round = [](float v) { return std::fmod(v * 64.0f, 1.0f) == 0.0f; };
+    return round(before) && round(now);
+}
+
+} // namespace
+
+const Uniforms* FrameInterpolator::Draw(const DrawDesc& desc, bool between) {
+    ++draws_;
+    Drawn& own_frame = now_[desc.key];
+    own_frame.uniforms.push_back(*desc.uniforms);
+    own_frame.moves.push_back(Uniforms{});
+    own_frame.restless.push_back(0);
+    const size_t place = own_frame.uniforms.size() - 1;
+    if (!between) {
+        return nullptr;
+    }
+    const auto before_it = before_.find(desc.key);
+    if (desc.geometry) {
+        if (before_it != before_.end() && place < before_it->second.uniforms.size()) {
+            ++matched_;
+        }
+        return nullptr;
+    }
+
+    Mask96 placing = Mask96::All(), shared;
+    if (desc.program) {
+        const PlacingKey pk{desc.program_id, desc.entry, desc.outputs, desc.coordinates};
+        auto it = placing_.find(pk);
+        if (it == placing_.end()) {
+            it = placing_
+                     .emplace(pk, desc.program->PlacingUniforms(desc.entry, desc.outputs,
+                                                                desc.coordinates))
+                     .first;
+        }
+        placing = it->second.first;
+        shared = it->second.second;
+    }
+    if (before_it == before_.end()) {
+        return nullptr;
+    }
+    Drawn& drawn = before_it->second;
+    const Mask96 placed_mask = placing | shared;
+
+    // The draw of the frame before, among those drawn the same way and not taken yet, whose
+    // uniforms placing the vertices are nearest a draw's, around its place among them, the one
+    // at its place when that is as near. A title can draw a model twice in an order of its own
+    // each frame, and in the order they came they would swap places.
+    const Uniforms& now_uniforms = own_frame.uniforms[place];
+    const auto distance = [&](const Uniforms& before) {
+        float total = 0.0f;
+        for (int u = 0; u < FLOAT_UNIFORMS; ++u) {
+            if (!placed_mask.Test(u)) {
+                continue;
+            }
+            for (int i = 0; i < 4; ++i) {
+                total += std::fabs(before[u][i] - now_uniforms[u][i]);
+            }
+        }
+        // NaN as far as anything gets
+        return std::isnan(total) ? std::numeric_limits<float>::infinity() : total;
+    };
+    const size_t count = drawn.uniforms.size();
+    size_t around_begin = 0, around_end = count;
+    if (count > NEAREST) {
+        around_begin = place > NEAREST / 2 ? place - NEAREST / 2 : 0;
+        around_end = std::min(place + NEAREST / 2, count);
+    }
+    std::optional<std::pair<size_t, float>> best;
+    if (place < count && !drawn.taken[place]) {
+        const float d = distance(drawn.uniforms[place]);
+        if (d == 0.0f) {
+            best = {place, d};
+            around_begin = around_end; // nothing nearer than nothing
+        } else {
+            best = {place, d};
+        }
+    }
+    for (size_t i = around_begin; i < around_end; ++i) {
+        if (i == place || drawn.taken[i]) {
+            continue;
+        }
+        const float d = distance(drawn.uniforms[i]);
+        if (!best || d < best->second) {
+            best = {i, d};
+        }
+    }
+    if (!best) {
+        return nullptr;
+    }
+    const size_t found = best->first;
+    drawn.taken[found] = true;
+
+    const Uniforms& before = drawn.uniforms[found];
+    const Uniforms& moved_before = drawn.moves[found];
+    const uint8_t restless = drawn.restless[found];
+    Uniforms& moved_now = own_frame.moves[place];
+    uint8_t& still_restless = own_frame.restless[place];
+    still_restless = restless > 0 ? restless - 1 : 0;
+    for (int u = 0; u < FLOAT_UNIFORMS; ++u) {
+        for (int i = 0; i < 4; ++i) {
+            moved_now[u][i] = now_uniforms[u][i] - before[u][i];
+        }
+    }
+    ++matched_;
+
+    const auto is_shared = [&](int u) { return shared.Test(u); };
+    // what moves: the components that changed of the uniforms placing the vertices, but for
+    // steps of those the coordinates may read
+    const auto moves = [&](int u, float b, float n) {
+        return placed_mask.Test(u) && b != n && !(is_shared(u) && Steps(b, n));
+    };
+    bool any_change = false;
+    for (int u = 0; u < FLOAT_UNIFORMS && !any_change; ++u) {
+        for (int i = 0; i < 4; ++i) {
+            if (moves(u, before[u][i], now_uniforms[u][i])) {
+                any_change = true;
+                break;
+            }
+        }
+    }
+    if (!any_change) {
+        return nullptr;
+    }
+
+    bool jumped = false, lerped = false;
+    // a component jumps when its move differs from its move the frame before by more than JUMP
+    // says. NaN and infinity compare false, and jump
+    const auto jumps = [](float b, float n, float moved_b) {
+        const float change = std::fabs(n - b - moved_b);
+        return !(change <= JUMP || change <= JUMP_PART * std::max(std::fabs(b), std::fabs(n)));
+    };
+    for (int u = 0; u < FLOAT_UNIFORMS; ++u) {
+        std::array<bool, 4> moving{}, jumping{};
+        bool any_jump = false, any_move = false;
+        for (int i = 0; i < 4; ++i) {
+            moving[i] = moves(u, before[u][i], now_uniforms[u][i]);
+            jumping[i] = moving[i] && jumps(before[u][i], now_uniforms[u][i], moved_before[u][i]);
+            any_jump |= jumping[i];
+            any_move |= moving[i];
+        }
+        if (any_jump) {
+            // one the coordinates may read too is as the frame has it, whatever it is, one that
+            // only places the vertices says the draw is another than the one before
+            if (!is_shared(u)) {
+                jumped = true;
+                break;
+            }
+            between_[u] = now_uniforms[u];
+            continue;
+        }
+        for (int i = 0; i < 4; ++i) {
+            between_[u][i] = moving[i]
+                                 ? before[u][i] + (now_uniforms[u][i] - before[u][i]) * 0.5f
+                                 : now_uniforms[u][i];
+        }
+        lerped |= any_move;
+    }
+    if (!jumped && !lerped) {
+        // what moved jumped, and is as the frame has it
+        return nullptr;
+    }
+    if (jumped) {
+        if (restless == 0) {
+            ++jumped_;
+        } else {
+            ++jumping_;
+        }
+        still_restless = RESTLESS;
+        return nullptr;
+    }
+    ++moved_;
+    return &between_;
+}
+
+Matches FrameInterpolator::FrameDone() {
+    const Matches matches{draws_, matched_, moved_, jumped_, jumping_};
+    // the draws of this frame are the ones the next frame's match
+    std::swap(before_, now_);
+    for (auto& [key, drawn] : before_) {
+        drawn.taken.assign(drawn.uniforms.size(), false);
+    }
+    // emptied, with the lists of the draws that frame had, which the next one mostly draws too
+    for (auto it = now_.begin(); it != now_.end();) {
+        Drawn& drawn = it->second;
+        const bool kept = !drawn.uniforms.empty();
+        drawn.uniforms.clear();
+        drawn.moves.clear();
+        drawn.restless.clear();
+        drawn.taken.clear();
+        it = kept ? std::next(it) : now_.erase(it);
+    }
+    draws_ = matched_ = moved_ = jumped_ = jumping_ = 0;
+    return matches;
+}
+
+} // namespace FrameInterp
