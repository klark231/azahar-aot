+                     "render stats: {:.0f} passes/s, {:.0f} draws/s ({:.1f} per pass), {:.1f} "
+                     "flushes/s, shadow-storage misses so far: {}",
+                     passes / secs, draws / secs, static_cast<double>(draws) / passes,
+                     flushes / secs, g_shadow_storage_misses.load());
+        }
+        draws = passes = flushes = 0;
+        since = now;
+    }
+};
+PassStats pass_stats;
