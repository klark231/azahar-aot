+void Driver::ClassifyCpuDraw(Pica::PicaCore& pica) {
+    using Regs = Pica::PipelineRegs;
+    const auto& pipeline = pica.regs.internal.pipeline;
+    const bool geometry = pipeline.use_gs != Regs::UseGS::No;
+    CpuCause cause = Other;
+    if (geometry && pipeline.gs_config.mode != Regs::GSMode::Point) {
+        cause = GsNotPoint;
+    } else if (geometry && pipeline.triangle_topology != Regs::TriangleTopology::Shader) {
+        cause = GsTopology;
+    } else if (pipeline.triangle_topology == Regs::TriangleTopology::Fan) {
+        cause = Fan;
+    }
+    ++cpu_causes[cause];
+    u64 program = pica.vs_setup.GetProgramCodeHash();
+    if (geometry) {
+        program ^= pica.gs_setup.GetProgramCodeHash() * 31;
+    }
+    if (cpu_programs.size() < 512 || cpu_programs.count(program)) {
+        ++cpu_programs[program];
+    }
+}
